NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App de instância única: qualquer login (senha ou Google) com um e-mail
# diferente deste é deslogado automaticamente. Opcional — sem essa var,
# o valor padrão em lib/allowed-email.ts é usado.
ALLOWED_EMAIL=gcordeirocarvalho97@gmail.com

# Ponto configurável de modelo — endpoint OpenAI-compatible.
# Funciona com Ollama local ou com um proxy compatível para Anthropic/OpenAI.
AI_API_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2:3b
